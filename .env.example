# .env.example — copy to .env and fill in. .env is gitignored; never commit
# real values. Only used by docker-compose.yml for port/model overrides and
# by ragkit itself via the RAGKIT_* overrides (see ragkit/config.py).

# --- docker-compose port overrides (all bind to 127.0.0.1) ---
QDRANT_PORT=6333
TIKA_PORT=9998
RERANKER_PORT=8009
OLLAMA_PORT=11434

# --- reranker sidecar ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- ragkit config overrides (optional; ragkit.yaml is the primary source) ---
# RAGKIT_OLLAMA_URL=http://localhost:11434
# RAGKIT_EMBED_MODEL=bge-m3
# RAGKIT_QDRANT_URL=http://localhost:6333
# RAGKIT_TIKA_URL=http://localhost:9998
# RAGKIT_RERANKER_URL=http://localhost:8009
# RAGKIT_COLLECTION=ragkit
